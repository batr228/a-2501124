<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#455AA8" android:padding="16dp" android:text="Report 2" android:textColor="#FFFFFF" android:textSize="22sp"/>
    <Button android:id="@+id/btnConfirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="첫 번째 버튼 · 확인"/>
    <Button android:id="@+id/btnName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="두 번째 버튼 · 이름 입력"/>
    <Button android:id="@+id/btnGrade" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="세 번째 버튼 · 학년 선택 (짝수)"/>
</LinearLayout>
