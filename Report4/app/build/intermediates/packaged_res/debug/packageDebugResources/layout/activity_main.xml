    <Button android:id="@+id/btnGcd" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="최대공약수와 최소공배수"/>
    <Button android:id="@+id/btnBmi" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="SeekBar로 BMI 계산"/>
    <Button android:id="@+id/btnTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="온도 변환"/>
